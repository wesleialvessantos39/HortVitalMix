{
  "name": "hortivitalmix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/contract --reporter=verbose",
    "test:integration": "HVM_INTEGRATION_ENABLED=true vitest run tests/integration --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "preview": "vite preview --host=0.0.0.0",
    "lint": "npm run typecheck && tsx scripts/check-client-secrets.ts",
    "verify": "npm run typecheck && npm run test",
    "preflight": "tsx scripts/preflight.ts",
    "verify:foundation": "tsx scripts/verify-foundation.ts",
    "release:current": "tsx scripts/release-current.ts",
    "verify:deploy": "tsx scripts/verify-deploy.ts",
    "homologate": "npm run preflight && npm run verify && npm run build && npm run verify:foundation"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "pg": "^8.16.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
