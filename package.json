{
  "name": "hortivitalmix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run test:t12:unit && npm run verify:t12:evidence && tsc --noEmit -p tsconfig.build.json && vite build && node scripts/check-bundle-secrets.mjs",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:t12:unit": "vitest run tests/unit/localityContracts.test.ts tests/unit/accessScope.test.ts",
    "verify:t12:evidence": "node scripts/verify-locality-evidence.mjs",
    "verify:t12:free": "node scripts/verify-locality-evidence.mjs --free-tier",
    "verify:trilha05": "node scripts/verify-trilha05-evidence.mjs",
    "verify:trilha08": "node scripts/verify-trilha08-evidence.mjs",
    "migrations:manifest": "tsx scripts/migrations-manifest.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  }
}
