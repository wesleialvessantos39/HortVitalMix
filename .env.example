# =============================================================================
# HortiVitalMix — Variáveis de Ambiente
# =============================================================================
# COPIE este arquivo para .env.local e preencha com valores reais.
# NUNCA comite .env.local, .env.production ou similares.
# =============================================================================

# --- Identidade pública (expostas ao browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend privilegiado (NUNCA expor ao browser) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=

# --- Postgres (pooler transacional) ---
# Formato: postgresql://postgres.<ref>:<senha>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# NUNCA cole o bloco "host=... port=... user=..." — não é aceito.
# DATABASE_URL é apenas alias legado em development; não configure em homologation/production.
SUPABASE_DB_URL=

# --- Segurança interna ---
# 32+ caracteres. Usado para hash de IP em auditoria.
APP_IP_PEPPER=
# 64 caracteres hex. Reservado para cifrar payload de outbox nas trilhas correspondentes.
OUTBOX_ENCRYPTION_KEY=
# CSV de origins adicionais exatas. Ex.: https://preview-proprio.vercel.app
HVM_ALLOWED_ORIGINS=

# --- Contexto (opcional; derivado automaticamente) ---
# APP_ENV=development
