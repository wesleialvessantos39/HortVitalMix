# Preencher em .env local ou nas variáveis protegidas da plataforma. Nunca versionar segredos.
# Credenciais distintas por ambiente; não compartilhar banco/Auth/Storage entre dev, homolog e main.
APP_ENV=development
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_JWT_SECRET=
APP_IP_PEPPER=
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_COMMIT_SHA=
# Somente para testes reais em ambiente isolado; proibido apontar para produção.
RUN_SUPABASE_INTEGRATION=0
SUPABASE_TEST_PROJECT_REF=
