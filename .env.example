# =============================================================================
# HortiVitalMix — Variáveis de Ambiente / Trilha 01
# =============================================================================
# Copie para .env.local no desenvolvimento. Nunca versione valores reais.
# Development, homologation e production devem usar credenciais distintas.
#
# IMPORTANTE:
# Este arquivo lista apenas variáveis de runtime realmente obrigatórias.
# Variáveis exclusivas de testes/homologação não pertencem ao runtime do
# Google AI Studio e não devem ser solicitadas como secrets da aplicação.
# =============================================================================

# --- Contexto ---
APP_ENV=development
SUPABASE_PROJECT_REF=

# --- Supabase público / frontend ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend privilegiado (NUNCA usar prefixo VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres / Transaction Pooler ---
# Formato canônico:
# postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
SUPABASE_DB_URL=

# --- Segurança interna ---
# 32+ caracteres hexadecimais; usado para hashing de IP em auditoria.
APP_IP_PEPPER=
# 64 caracteres hex; reservado para a Trilha 04.
OUTBOX_ENCRYPTION_KEY=
# CSV de origins externas exatas, quando realmente necessárias.
# localhost/127.0.0.1 já são aceitos automaticamente em development.
APP_ALLOWED_ORIGINS=
