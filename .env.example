# =============================================================================
# HortiVitalMix — Variáveis de Ambiente / Trilha 01
# =============================================================================
# Copie para .env.local no desenvolvimento. Nunca versione valores reais.
# Development, homologation e production devem usar credenciais distintas.
# =============================================================================

# --- Contexto ---
APP_ENV=development
SUPABASE_PROJECT_REF=

# --- Supabase público / frontend ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend privilegiado (NUNCA usar prefixo VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=
# Opcional enquanto tokens forem validados via SDK/JWKS.
SUPABASE_JWT_SECRET=

# --- Postgres / Transaction Pooler ---
# Formato canônico:
# postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
SUPABASE_DB_URL=

# --- Segurança interna ---
# 32+ caracteres hexadecimais; usado para hashing de IP em auditoria.
APP_IP_PEPPER=
# 64 caracteres hex; reservado para a Trilha 04 (outbox cifrado).
OUTBOX_ENCRYPTION_KEY=
# CSV de origins exatas aceitas para mutações. Ex.: https://preview.exemplo.app
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Testes reais ---
# Habilitar somente contra projeto development isolado.
HVM_INTEGRATION_ENABLED=false
# Project ref de production usado pelo guard para recusar testes perigosos.
# Na estratégia Free atual, production continua sendo xipbsazvymkqqfmfegwu mesmo quando estiver pausado.
HVM_PROD_PROJECT_REF=
