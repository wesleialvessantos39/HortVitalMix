# =============================================================================
# HortiVitalMix — Variáveis de Ambiente / Trilha 02
# =============================================================================
# Copie para .env.local no desenvolvimento. Nunca versione valores reais.
# O projeto atual usa o Supabase canônico existente; não criar projeto paralelo.
# Development/homologation reais só podem usar credenciais isoladas quando existirem.
#
# IMPORTANTE:
# Este arquivo lista apenas variáveis de runtime realmente obrigatórias.
# Variáveis exclusivas de testes/homologação não pertencem ao runtime do
# Google AI Studio e não devem ser solicitadas como secrets da aplicação.
# =============================================================================

# --- Contexto ---
APP_ENV=development
SUPABASE_PROJECT_REF=

# --- Supabase público / frontend ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend privilegiado (NUNCA usar prefixo VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres / Transaction Pooler ---
# Formato canônico:
# postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
SUPABASE_DB_URL=

# --- Segurança interna ---
# 32+ caracteres hexadecimais; usado para hashing de IP em auditoria.
APP_IP_PEPPER=
# 64 caracteres hex; reservado para a Trilha 04.
OUTBOX_ENCRYPTION_KEY=
# CSV de origins externas exatas, quando realmente necessárias.
# localhost/127.0.0.1 já são aceitos automaticamente em development.
APP_ALLOWED_ORIGINS=

# --- Trilha 04: comunicação segura ---
# Obrigatória para cifrar OTP/tokens antes de persistir na outbox.
# Gere exatamente 32 bytes / 64 caracteres hex.
# OUTBOX_ENCRYPTION_KEY já declarado acima e deve receber valor real no runtime.
PUBLIC_ORIGIN=https://hortivitalmix.vercel.app

# E-mail: escolha "resend" ou "gmail". Sem credenciais, a mensagem permanece
# na outbox como falha para retry; o código/token nunca é gravado em claro.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
GMAIL_ACCESS_TOKEN=
GMAIL_FROM_EMAIL=

# SMS opcional. Sem provider configurado, a entrega SMS não é realizada.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
