# HortiVitalMix — Volume 01 / Trilha 01
# Copie para .env.local e preencha com valores reais. Nunca comite secrets.

# Identidade pública (browser)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-ou-publishable-key>

# Server-side
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-ou-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-ou-secret-key>
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
SUPABASE_JWT_SECRET=<jwt-secret>
SUPABASE_PROJECT_REF=<project-ref>

# Segurança interna
APP_IP_PEPPER=<32-ou-mais-caracteres>
OUTBOX_ENCRYPTION_KEY=<64-caracteres-hex>

# Contexto opcional; derivado quando omitido
APP_ENV=development
APP_RELEASE=trilha01-v1
